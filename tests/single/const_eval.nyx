const fn square(n: i32): i32 = n * n;

// recursive CTFE
const fn fib(n: i32): i32 {
    if n < 2 return n; else {
        return fib(n - 1) + fib(n - 2);
    }
}

// this will not be evaluated away
fn triple(n: i32): i32 = n * 3;

fn main(): i32 {
    if square(7) != 49 return 1;

    if fib(20) != 6765 return 2;

    let base = 6;
    let scaled = square(base) - 6;
    if scaled != 30 return 3;

    let mut total = 0;
    loop i in 1..=10 {
        total = total + i;
    }
    if total != 55 return 4;

    let mut acc = 0;
    loop i in 0..10 {
        if i == 8 {
            break;
        }
        if i == 2 {
            continue;
        }
        loop j in 1..=3 {
            acc = acc + i * j
        }
    }
    if acc != 156 return 5;

    if triple(14) != 42 return 6;

    42
}
