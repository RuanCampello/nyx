struct Pair {
    x: i32,
    y: i32,
}

const PAIR: Pair = Pair { x: 40, y: 2 };

static GREETING: &str = "hello";

static LIMIT: i32 = 10;

static mut CURSOR: i32 = 0;

static mut SEEDED: uptr = 7;

@unsafe
fn bump(): i32 {
    CURSOR = CURSOR + 1;
    CURSOR
}

@unsafe
fn main(): i32 {
    // an immutable static reads without an unsafe context
    if LIMIT != 10 return 1;

    // `.bss`: a zero initialiser is not carried in the image
    if CURSOR != 0 return 2;

    // `.data`: a non-zero initialiser is
    if SEEDED != 7 return 3;

    // the write must outlive the call that made it
    if bump() != 1 return 4;
    if bump() != 2 return 5;
    if CURSOR != 2 return 6;

    SEEDED = SEEDED * 6;
    if SEEDED != 42 return 7;

    loop {
        if CURSOR >= LIMIT {
            break;
        }
        bump();
    }

    if CURSOR != 10 return 8;

    // a string static carries both halves of its fat pointer
    if GREETING.len() != 5 return 9;

    // a field of a constant struct is spliced in like any other constant
    if PAIR.x + PAIR.y != 42 return 10;

    SEEDED as i32
}
