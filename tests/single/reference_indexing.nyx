// indexing auto-derefs its base the way field access does, so an array or a
// slice reached through a reference is indexed in place
fn get(values: &[i32; 3], at: i32): i32 = values[at];

fn set(values: &mut [i32; 3], at: i32) {
    values[at] = 40;
    values[at] += 2;
}

fn second(values: &[i32; 3]): i32 {
    let element = &values[1];
    *element
}

fn total(values: &[i32]): i32 {
    let mut sum = 0;
    loop at in 0..3 {
        sum += values[at];
    }
    sum
}

fn ends(values: & &[i32]): i32 = values[0] + values[2];

fn main(): i32 {
    let mut values: [i32; 3] = [1, 2, 3];

    if get(&values, 1) != 2 return 1;
    if second(&values) != 2 return 2;

    let slice: &[i32] = &values;
    if total(slice) != 6 return 3;
    if ends(&slice) != 4 return 4;

    set(&mut values, 0);
    if values[0] != 42 return 5;

    0
}
