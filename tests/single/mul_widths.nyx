// products that fit their own type but overflow every narrower one, so a checked
// multiplication that tests the wrong width reports a spurious overflow
fn i16_product(a: i16, b: i16): i16 = a * b;

fn i32_product(a: i32, b: i32): i32 = a * b;

fn i64_product(a: i64, b: i64): i64 = a * b;

fn main(): i32 {
    if i16_product(181, 181) != 32761 return 1;
    if i32_product(46340, 46340) != 2147395600 return 2;
    if i64_product(3037000499, 3037000499) != 9223372030926249001 return 3;

    if i16_product(-181, 181) != -32761 return 4;
    if i32_product(-46340, 46340) != -2147395600 return 5;
    if i64_product(-3037000499, 3037000499) != -9223372030926249001 return 6;

    0
}
