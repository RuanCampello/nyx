use std::panic::{assert, assert_eq};

interface Bounded {
    const LIMIT: i64;
    const fn peak(&self): i64;
    const fn headroom(&self): i64 = self.peak() - 1;
}

impl Circle with Bounded {
    const LIMIT: i64 = 50;
    const fn peak(&self): i64 = self.radius * 10;
}

interface Named {
    fn tag(&self): i64;
}

impl Rectangle with Named {
    const fn tag(&self): i64 = 7;
}

interface Shape {
    fn area(&self): i64;
    fn perimeter(&self): i64;
    fn is_larger_than(&self, other_area: i64): bool;
}

struct Rectangle {
    width: i64,
    height: i64,
}

struct Circle {
    // radius stored scaled by 1000 to avoid floats
    // area = radius * radius * 3 (approx pi=3 for integer arithmetic)
    radius: i64,
}

impl Rectangle with Shape {
    fn area(&self): i64 = self.width * self.height;
    fn perimeter(&self): i64 = 2 * self.width + 2 * self.height;
    fn is_larger_than(&self, other_area: i64): bool = self.area() > other_area;
}

impl Circle with Shape {
    fn area(&self): i64 = self.radius * self.radius * 3;
    fn perimeter(&self): i64 = 2 * self.radius * 3;
    fn is_larger_than(&self, other_area: i64): bool = self.area() > other_area;
}

fn main(): i64 {
    let rect = Rectangle { width: 4, height: 5 };

    // area = 4 * 5 = 20
    assert_eq(rect.area(), 20);
    // perimeter = 2*4 + 2*5 = 18
    assert_eq(rect.perimeter(), 18);
    // 20 > 15 = true
    assert(rect.is_larger_than(15));
    // 20 > 25 = false
    assert(!rect.is_larger_than(25));

    let circle = Circle { radius: 3 };
    // area = 3 * 3 * 3 = 27
    assert_eq(circle.area(), 27);
    // perimeter = 2 * 3 * 3 = 18
    assert_eq(circle.perimeter(), 18);
    // 27 > 20 = true
    assert(circle.is_larger_than(20));
    // 27 > 30 = false
    assert(!circle.is_larger_than(30));
    // cross-check rect.area() < circle.area()
    assert(rect.area() < circle.area());
    assert_eq(circle.peak(), 30);
    assert_eq(circle.headroom(), 29);
    assert_eq(rect.tag(), 7);

    0
}
