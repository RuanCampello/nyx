fn classify(n: i32): i32 {
    match n {
        0 -> 100,
        _ -> 1,
    }
}

fn main(): i32 {
    let plain = {
        let a = 20;
        let b = 22;

        a + b
    };
    if plain != 42 return 1;

    let picked = if plain > 40 {
        7
    } else {
        9
    };
    if picked != 7 return 2;

    let chained = if plain < 10 {
        1
    } else if plain < 100 {
        2
    } else {
        3
    };
    if chained != 2 return 3;

    let matched = match plain {
        42 -> 100,
        _ -> 200,
    };
    if matched != 100 return 4;

    // a block nested in a branch, and a match nested in a block
    let nested = {
        let inner = if true {
            let d = 3;

            d * 2
        } else {
            0
        };

        inner + classify(inner)
    };
    if nested != 7 return 5;

    let typed: i64 = if nested == 7 {
        1
    } else {
        2
    };
    if typed != 1 return 6;

    // a block with no tail is unit, and still runs its statements
    let mut counter = 0;
    {
        counter += 5;
    }
    if counter != 5 return 7;

    return 42;
}
