use std::ops::{Index};
use std::panic::{assert_eq};

enum Nucleotide {
    A,
    C,
    G,
    T,
}

struct NucleotideCount {
    a: uptr,
    c: uptr,
    g: uptr,
    t: uptr,
}

impl NucleotideCount with Index<Nucleotide>{
    type Output = uptr;

    inline const fn index(&self, nucleotide: Nucleotide): &Self::Output {
        match nucleotide {
            Nucleotide::A -> &self.a,
            Nucleotide::C -> &self.c,
            Nucleotide::G -> &self.g,
            Nucleotide::T -> &self.t,
        }
    }
}

fn main(): i32 {
    let nucleotide_count = NucleotideCount {a: 14, c: 9, g: 10, t: 12};

    assert_eq(nucleotide_count[Nucleotide::A], 14 as uptr);
    assert_eq(nucleotide_count[Nucleotide::C], 9 as uptr);
    assert_eq(nucleotide_count[Nucleotide::G], 10 as uptr);
    assert_eq(nucleotide_count[Nucleotide::T], 12 as uptr);

    0
}
