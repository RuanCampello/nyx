pub fn abs(n: i64): i64 {
    match n < 0 {
        true -> -n,
        _ -> n,
    }
}

pub fn max(a: i64, b: i64): i64 {
    match a > b {
        true -> a,
        _ -> b
    }
}

pub fn min(a: i64, b: i64): i64 {
    match a < b {
        true -> a,
        _ -> b
    }
}

pub fn clamp(value: i64, lo: i64, hi: i64): i64 = min(max(value, lo), hi);
